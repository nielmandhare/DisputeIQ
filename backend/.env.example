# ============================================================================
# DisputeIQ backend — environment configuration (EXAMPLE ONLY)
# Copy to `.env` and fill in real values. NEVER commit `.env`.
# Secrets are read by the server via process.env; the frontend NEVER receives
# the key secret or webhook secret.
# ============================================================================

# --- Razorpay (Test Mode for the buildathon) ---
# From https://dashboard.razorpay.com/app-keys (use TEST keys)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_test_key_secret_here

# --- Razorpay submission mode (Slice 8) ---
# SIMULATED (default): no external API call. The backend marks the submission as
# a simulation and returns a clearly-labeled result. SAFE for the demo.
# LIVE: only effective when BOTH RAZORPAY_KEY_ID and RAZORPAY_KEY_SECRET are set.
# Sends a real contest request to Razorpay. Do NOT enable for the demo unless you
# intend to submit a real test dispute.
RAZORPAY_SUBMISSION_MODE=simulated

# Webhook secret configured in Dashboard -> Account & Settings -> Webhooks.
# Used to verify X-Razorpay-Signature (HMAC-SHA256 over the RAW body).
RAZORPAY_WEBHOOK_SECRET=your_test_webhook_secret_here

# --- Server ---
PORT=4000
# Public base URL the frontend calls. In dev the Vite server proxies /api here.
BACKEND_BASE_URL=http://localhost:4000

# --- Database ---
# SQLite file (node:sqlite, Node >= 22). Relative to backend/ dir.
DATABASE_PATH=./disputeiq.db

# --- LLM classification engine (Slice 3+) ---
# Leave LLM_API_KEY empty to use the built-in deterministic HEURISTIC classifier
# (no external dependency; emits grounded source spans). Set a key to enable the
# structured LLM classifier.
#
# PROVIDER-AGNOSTIC: speaks the OpenAI-compatible /chat/completions contract.
# Works with OpenAI, OpenRouter, or any local OpenAI-compatible server. To switch
# providers, change ONLY these env vars (no code change). The default is OpenRouter.
LLM_API_KEY=
# OpenRouter (default). OpenAI-compatible. https://openrouter.ai/keys
LLM_BASE_URL=https://openrouter.ai/api/v1
# Use the CHEAPEST capable model you want. OpenRouter route slugs: "openai/gpt-4o-mini",
# "openai/gpt-4o", "anthropic/claude-3-haiku", "google/gemini-flash-1.5", etc.
# Do NOT auto-select an expensive model; set the exact one you want here.
LLM_MODEL=openai/gpt-4o-mini
LLM_TIMEOUT_MS=15000
# Optional OpenRouter identifying headers (harmless to other endpoints):
# LLM_REFERER=https://disputeiq.local
# LLM_TITLE=DisputeIQ

# --- Storage (Phase 1B evidence upload; not used by Slice 1) ---
STORAGE_DIR=./storage

# --- Dev / Demo ---
# When "true" and no live Razorpay credentials are present, the backend still
# works via a LABELED SIMULATED dispute seed (POST /dev/seed-dispute). This is
# NEVER presented as a real Razorpay capability. Set "false" to require real keys.
DISPUTEIQ_DEV_SEED=true

# --- Production hardening (M2): API auth + CORS ---
# Leave DISPUTEIQ_API_KEY EMPTY to run the local hackathon demo: auth is
# disabled (explicit dev mode) and the frontend works unchanged.
# For production, set a STRONG secret here. Every mutating /api route
# (submission, approval, demo seed/reset, evidence upload/reclassify, etc.)
# will then require:  Authorization: Bearer <DISPUTEIQ_API_KEY>
# (or the X-Api-Key header). Missing/invalid => HTTP 401. NEVER commit a real
# value; NEVER ship it to the frontend bundle.
DISPUTEIQ_API_KEY=
# Comma-separated list of allowed CORS origins. When SET, only these origins are
# permitted and the wildcard "*" is NEVER used. For the demo use the Vite port(s).
# In production list your real frontend origin(s) explicitly. Do NOT leave this
# empty in production (an empty value makes the server reflect the request Origin
# — acceptable for local dev, not for production).
DISPUTEIQ_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174
